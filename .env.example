# Optional. Without it /api/ask degrades to the deterministic extractive answerer
# instead of a generated one. The site stays fully functional either way.
ANTHROPIC_API_KEY=

# Model used by /api/ask. claude-haiku-4-5-20251001 is the low-cost alternative.
ASK_MODEL=claude-sonnet-5

# Canonical origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://drilon7.vercel.app
